# Bu faylın adını ".env" edin və dəyərləri yazın. .env faylını heç vaxt GitHub-a yükləməyin.

# @BotFather-dən aldığınız bot tokeni
TELEGRAM_BOT_TOKEN=

# internal = server.py özü hər dəqiqə yoxlayır; n8n = yoxlamanı n8n işə salır
SCHEDULER=internal

# n8n üçün gizli açar (istənilən uzun söz). n8n HTTP Request-də X-SkyPulse-Key başlığına yazılır.
RUN_KEY=

# 127.0.0.1 = yalnız bu kompüter. Telefonla eyni Wi-Fi-dan açmaq üçün 0.0.0.0 yazın.
HOST=127.0.0.1
PORT=8000
