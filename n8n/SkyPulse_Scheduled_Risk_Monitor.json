{
  "name": "SkyPulse — Scheduled Risk Monitor & Telegram Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 5 } ] }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/run-checks",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-SkyPulse-Key", "value": "PASTE_RUN_KEY_FROM_.env" } ] },
        "options": { "timeout": 120000 }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Run SkyPulse checks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.errors }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Any errors?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Every 5 minutes": { "main": [ [ { "node": "Run SkyPulse checks", "type": "main", "index": 0 } ] ] },
    "Run SkyPulse checks": { "main": [ [ { "node": "Any errors?", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
